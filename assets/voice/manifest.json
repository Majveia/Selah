    "intro_01": {
     "file": "alan/intro_01.mp3",
     "duration": 8.675,
     "text": "Before the first light, there was silence. A silence so complete, it had no edge.",
     "captions": [
      {
       "t0": 0.106,
       "t1": 1.672,
       "text": "Before the first light,"
      },
      {
       "t0": 2.122,
