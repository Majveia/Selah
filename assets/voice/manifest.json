       "t1": 1.842,
       "text": "This is the cosmic web."
      },
      {
       "t0": 2.892,
       "t1": 3.78,
       "text": "Every thread,"
      },
      {
       "t0": 4.18,
       "t1": 5.886,
       "text": "a river of galaxies."
      },
      {
       "t0": 6.736,
       "t1": 7.943,
       "text": "Every galaxy,"
      },
      {
       "t0": 8.343,
       "t1": 10.349,
       "text": "a hundred billion suns."
      }
     ]
    },
