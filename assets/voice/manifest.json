       "text": "worlds."
      },
      {
       "t0": 5.118,
       "t1": 6.115,
       "text": "Oceans."
      },
      {
       "t0": 6.865,
       "t1": 7.893,
       "text": "Mountains."
      },
      {
       "t0": 8.643,
       "t1": 9.511,
       "text": "Cities."
      },
      {
       "t0": 10.611,
       "t1": 12.197,
       "text": "Someone, somewhere,"
      },
      {
       "t0": 12.747,
       "t1": 13.845,
       "text": "looking up."
      }
     ]
    },
