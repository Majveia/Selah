       "text": "there was silence."
      },
      {
       "t0": 4.599,
       "t1": 6.654,
       "text": "A silence so complete,"
      },
      {
       "t0": 7.154,
       "t1": 8.561,
       "text": "it had no edge."
      }
     ]
    },
    "intro_02": {
     "file": "alan/intro_02.mp3",
     "duration": 4.384,
     "text": "And then… the silence took a breath.",
     "captions": [
      {
       "t0": 0.104,
       "t1": 0.992,
       "text": "And then…"
      },
      {
       "t0": 2.442,
       "t1": 4.268,
       "text": "the silence took a breath."
      }
     ]
    },
    "intro_03": {
     "file": "alan/intro_03.mp3",
     "duration": 8.805,
     "text": "In its first minutes, the universe made hydrogen. Everything else, it left to the stars.",
     "captions": [
      {
       "t0": 0.106,
       "t1": 1.642,
       "text": "In its first minutes,"
      },
      {
       "t0": 2.042,
       "t1": 4.048,
       "text": "the universe made hydrogen."
      },
      {
       "t0": 4.998,
       "t1": 6.245,
       "text": "Everything else,"
      },
      {
       "t0": 6.745,
       "t1": 8.691,
       "text": "it left to the stars."
      }
     ]
    },
    "intro_04": {
     "file": "alan/intro_04.mp3",
     "duration": 11.281,
     "text": "Then gravity began to sing. And slowly, the darkness gathered itself into rivers… and the rivers caught fire.",
     "captions": [
      {
       "t0": 0.106,
       "t1": 2.411,
       "text": "Then gravity began to sing."
      },
      {
       "t0": 3.411,
       "t1": 4.438,
       "text": "And slowly,"
      },
      {
       "t0": 4.938,
       "t1": 7.952,
       "text": "the darkness gathered itself into rivers…"
      },
      {
       "t0": 9.252,
       "t1": 11.167,
       "text": "and the rivers caught fire."
      }
     ]
    },
    "intro_05": {
     "file": "alan/intro_05.mp3",
     "duration": 10.463,
     "text": "This is the cosmic web. Every thread, a river of galaxies. Every galaxy, a hundred billion suns.",
